local Scrp = {}
local input = game:GetService("UserInputService")

local CurrentMain = nil
local TitleLabel = nil
local TabHolder = nil
local ContentHolder = nil
local Tabs = {}
local firstTab = true

local function create(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    return o
end

-- Простой и надёжный драг (прямое присвоение позиции, без твинов)
local function DraggingEnabled(frame, parent)
    parent = parent or frame
    local dragging = false
    local dragInput, mousePos, startPos

    frame.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = io.Position
            startPos = parent.Position

            io.Changed:Connect(function()
                if io.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch then
            dragInput = io
        end
    end)

    input.InputChanged:Connect(function(io)
        if io == dragInput and dragging then
            local delta = io.Position - mousePos
            parent.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

function Scrp.CreateWindowLib()
    local LibId = "Scrp_" .. tostring(math.random(1,999999))
    for _,v in pairs(game.CoreGui:GetChildren()) do
        if v.Name == LibId then v:Destroy() end
    end

    local ScreenGui = create("ScreenGui", {
        Name = LibId, Parent = game.CoreGui,
        ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })

    local Main = create("Frame", {
        Name = "Main", Parent = ScreenGui,
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        Position = UDim2.new(0.5, -300, 0.5, -140),
        Size = UDim2.new(0, 600, 0, 280)
    })
    create("UICorner", {CornerRadius = UDim.new(0,6), Parent = Main})

    DraggingEnabled(Main, Main)

    -- Открытие/закрытие на клавишу P
    input.InputBegan:Connect(function(io, gpe)
        if not gpe and io.KeyCode == Enum.KeyCode.P then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)

    CurrentMain = Main

    -- Левая колонка под вкладки (ниже надписи названия окна)
    TabHolder = create("Frame", {
        Name = "TabHolder", Parent = Main,
        BackgroundColor3 = Color3.fromRGB(15, 15, 15),
        Position = UDim2.new(0, 0, 0, 30),
        Size = UDim2.new(0, 130, 1, -30)
    })
    create("UIListLayout", {
        Parent = TabHolder,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2)
    })
    create("UIPadding", {
        Parent = TabHolder,
        PaddingTop = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6)
    })

    -- Контейнер под контент вкладок (справа от TabHolder)
    ContentHolder = create("Frame", {
        Name = "ContentHolder", Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 130, 0, 30),
        Size = UDim2.new(1, -130, 1, -30)
    })

    return ScreenGui, Main
end

-- Задаёт название окна, сверху слева
function Scrp.Name(name)
    name = name or "Window"
    if not CurrentMain then
        warn("Scrp.Name: сначала вызови Scrp.CreateWindowLib()")
        return
    end

    if not TitleLabel then
        TitleLabel = create("TextLabel", {
            Name = "Title",
            Parent = CurrentMain,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 6),
            Size = UDim2.new(1, -20, 0, 20),
            Font = Enum.Font.GothamBold,
            TextSize = 15,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = name
        })
    else
        TitleLabel.Text = name
    end

    return TitleLabel
end

-- Создаёт новую вкладку слева
function Scrp.LeftNewTab(name)
    name = name or "Tab"
    if not TabHolder or not ContentHolder then
        warn("Scrp.LeftNewTab: сначала вызови Scrp.CreateWindowLib()")
        return
    end

    local TabBtn = create("TextButton", {
        Name = name .. "Btn",
        Parent = TabHolder,
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        Size = UDim2.new(1, 0, 0, 30),
        AutoButtonColor = false,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        Text = name,
        TextColor3 = Color3.fromRGB(255, 255, 255)
    })
    create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = TabBtn})

    local Page = create("ScrollingFrame", {
        Name = name .. "Page",
        Parent = ContentHolder,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 3,
        Visible = false,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0)
    })
    create("UIListLayout", {
        Parent = Page,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8)
    })
    create("UIPadding", {
        Parent = Page,
        PaddingLeft = UDim.new(0, 10),
        PaddingTop = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10)
    })

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Page.Visible = false
            t.Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end)

    if firstTab then
        firstTab = false
        Page.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end

    table.insert(Tabs, {Btn = TabBtn, Page = Page})

    return Page
end

return Scrp
