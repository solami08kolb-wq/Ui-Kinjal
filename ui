        Font = Enum.Font.GothamBold,
        TextSize = 18,
        Text = "•",
        TextColor3 = Color3.fromRGB(150, 150, 150),
        AutoButtonColor = false
    })
    Dot.MouseButton1Click:Connect(function()
        ShowInfo(tipText)
    end)
    return Dot
end

-- Create window (parent optional). Returns ScreenGui, MainFrame
function Scrp.CreateWindowLib(parent)
    -- choose parent: priority: passed parent, LocalPlayer.PlayerGui, CoreGui
    parent = parent or (Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")) or game:GetService("CoreGui")

    local LibId = "Scrp_" .. tostring(math.random(1,999999))
    -- remove existing with same name in chosen parent
    for _, v in pairs(parent:GetChildren()) do
        if v.Name == LibId then v:Destroy() end
    end

    local ScreenGui = create("ScreenGui", {
        Name = LibId,
        Parent = parent,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })

    local connStore = {} -- to store connections for cleanup

    -- Main frame
    local Main = create("Frame", {
        Name = "Main",
        Parent = ScreenGui,
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        ClipsDescendants = true,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = WINDOW_SIZE
    })
    create("UICorner", {CornerRadius = UDim.new(0,6), Parent = Main})

    -- Setup dragging for this window via activeDrag
    enableWindowDragging(Main, Main)

    -- Open/close animation toggle on P (local to this screenGui)
    do
        local isOpen = true
        local animating = false
        local keyConn = UserInputService.InputBegan:Connect(function(io, gpe)
            if gpe then return end
            if io.KeyCode == Enum.KeyCode.P and not animating then
                animating = true
                if isOpen then
                    local tw = TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Size = UDim2.new(0, 0, 0, 0)
                    })
                    tw:Play()
                    tw.Completed:Connect(function()
                        Main.Visible = false
                        isOpen = false
                        animating = false
                    end)
                else
                    Main.Visible = true
                    Main.Size = UDim2.new(0, 0, 0, 0)
                    local tw = TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = WINDOW_SIZE
                    })
                    tw:Play()
                    tw.Completed:Connect(function()
                        isOpen = true
                        animating = false
                    end)
                end
            end
        end)
        table.insert(connStore, keyConn)
    end

    CurrentMain = Main

    -- Tab holder
    TabHolder = create("Frame", {
        Name = "TabHolder",
        Parent = Main,
        BackgroundColor3 = Color3.fromRGB(15, 15, 15),
        Position = UDim2.new(0, 0, 0, 30),
        Size = UDim2.new(0, 130, 1, -30)
    })
    create("UIListLayout", {
        Parent = TabHolder,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2)
    })
    create("UIPadding", {
        Parent = TabHolder,
        PaddingTop = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6)
    })

    -- Content holder
    ContentHolder = create("Frame", {
        Name = "ContentHolder",
        Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 130, 0, 30),
        Size = UDim2.new(1, -130, 1, -30)
    })

    -- Info panel
    InfoPanel = create("Frame", {
        Name = "InfoPanel",
        Parent = Main,
        BackgroundColor3 = Color3.fromRGB(25, 25, 25),
        Position = UDim2.new(0, 130, 1, 0),
        Size = UDim2.new(1, -130, 0, 36),
        ZIndex = 50
    })
    create("UICorner", {CornerRadius = UDim.new(0,4), Parent = InfoPanel})
    local InfoText = create("TextLabel", {
        Name = "InfoText",
        Parent = InfoPanel,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Color3.fromRGB(255,255,255),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Text = ""
    })

    -- Install single global input handlers for this GUI
    installGlobalInputHandlers(ScreenGui, connStore)

    -- Cleanup when ScreenGui destroyed
    local destroyConn = ScreenGui.Destroying:Connect(function()
        -- clear active drag if owned by this GUI
        activeDrag = nil
        disconnectAll(connStore)
    end)
    table.insert(connStore, destroyConn)

    return ScreenGui, Main
end

-- Public: Set window title
function Scrp.Name(name)
    name = name or "Window"
    if not CurrentMain then
        warn("Scrp.Name: сначала вызови Scrp.CreateWindowLib()")
        return
    end

    if not TitleLabel then
        TitleLabel = create("TextLabel", {
            Name = "Title",
            Parent = CurrentMain,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 6),
            Size = UDim2.new(1, -20, 0, 20),
            Font = Enum.Font.GothamBold,
            TextSize = 15,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = name
        })
    else
        TitleLabel.Text = name
    end

    return TitleLabel
end

-- Create left tab; returns page object and tab button
function Scrp.LeftNewTab(name)
    name = name or "Tab"
    if not TabHolder or not ContentHolder then
        warn("Scrp.LeftNewTab: сначала вызови Scrp.CreateWindowLib()")
        return
    end

    local TabBtn = create("TextButton", {
        Name = name .. "Btn",
        Parent = TabHolder,
        BackgroundColor3 = COLOR_INACTIVE,
        Size = UDim2.new(1, 0, 0, 30),
        AutoButtonColor = false,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        Text = name,
        TextColor3 = Color3.fromRGB(255, 255, 255)
    })
    create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = TabBtn})

    local Page = create("ScrollingFrame", {
        Name = name .. "Page",
        Parent = ContentHolder,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 3,
        Visible = false,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0)
    })
    create("UIListLayout", {
        Parent = Page,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8)
    })
    create("UIPadding", {
        Parent = Page,
        PaddingLeft = UDim.new(0, 10),
        PaddingTop = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10)
    })

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            if t.Page then t.Page.Visible = false end
            if t.Btn then t.Btn.BackgroundColor3 = COLOR_INACTIVE end
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = COLOR_ACTIVE
    end)

    if firstTab then
        firstTab = false
        Page.Visible = true
        TabBtn.BackgroundColor3 = COLOR_ACTIVE
    end

    table.insert(Tabs, {Btn = TabBtn, Page = Page, Name = name})
    CurrentPage = Page

    -- Return a simple tab object to allow selecting programmatically
    local tabObj = {}
    function tabObj:Select()
        TabBtn:CaptureFocus()
        for _, t in pairs(Tabs) do
            if t.Page then t.Page.Visible = false end
            if t.Btn then t.Btn.BackgroundColor3 = COLOR_INACTIVE end
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = COLOR_ACTIVE
    end
    tabObj.Page = Page
    tabObj.Button = TabBtn
    return tabObj
end

-- NewSlider: text, tip, max, min, callback, default (optional)
function Scrp.NewSlider(text, tip, max, min, callback, default)
    text = text or "Slider"
    tip = tip or ""
    max = max or 100
    min = min or 0
    callback = callback or function() end
    default = (default ~= nil) and default or min

    if not CurrentPage then
        warn("Scrp.NewSlider: сначала вызови Scrp.LeftNewTab(\"name\")")
        return
    end

    -- prevent bad range
    local span = max - min
    if span == 0 then span = 1 end
    default = clamp(default, min, max)

    local SliderFrame = create("Frame", {
        Parent = CurrentPage,
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        Size = UDim2.new(1, 0, 0, 40)
    })
    create("UICorner", {CornerRadius = UDim.new(0,4), Parent = SliderFrame})

    local Label = create("TextLabel", {
        Parent = SliderFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 4),
        Size = UDim2.new(1, -30, 0, 16),
        Font = Enum.Font.Gotham,
        TextSize = 14,
        Text = text .. ": " .. tostring(default),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local Bar = create("Frame", {
        Parent = SliderFrame,
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        Position = UDim2.new(0, 10, 0, 26),
        Size = UDim2.new(1, -34, 0, 6)
    })
    create("UICorner", {CornerRadius = UDim.new(1,0), Parent = Bar})

    local Fill = create("Frame", {
        Parent = Bar,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Size = UDim2.new(initialFillFor(default, min, max), 0, 1, 0)
    })
    create("UICorner", {CornerRadius = UDim.new(1,0), Parent = Fill})

    AddInfoDot(SliderFrame, tip)

    -- Slider state object returned to user
    local slider = {
        Frame = SliderFrame,
        _value = default,
        onChange = callback,
        text = text,
        min = min,
        max = max,
        label = Label,
        bar = Bar,
        fill = Fill
    }

    -- Bar.InputBegan sets activeDrag
    Bar.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 then
            activeDrag = {
                kind = "slider",
                data = {
                    bar = Bar,
                    fill = Fill,
                    label = Label,
                    text = text,
                    min = min,
                    max = max,
                    onChange = callback,
                    _value = slider._value,
                    input = io
                }
            }
            -- immediate update in case click position different
            -- Use a small delay to ensure AbsoluteSize is valid after first render (if needed)
            if Bar.AbsoluteSize.X > 0 then
                -- compute immediate value via simulated InputChanged logic
                local absPos = Bar.AbsolutePosition
                local absSize = Bar.AbsoluteSize
                local rel = clamp((io.Position.X - absPos.X) / absSize.X, 0, 1)
                local span = max - min
                if span == 0 then span = 1 end
                local value = math.floor(min + span * rel)
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                Label.Text = text .. ": " .. tostring(value)
                slider._value = value
                pcall(function() callback(value) end)
            end
            -- end handled in global InputEnded
        end
    end)

    -- API methods
    function slider:GetValue()
        return self._value
    end
    function slider:SetValue(v)
        v = clamp(math.floor(v or self._value), self.min, self.max)
        local rel = initialFillFor(v, self.min, self.max)
        if self.fill then
            self.fill.Size = UDim2.new(rel, 0, 1, 0)
        end
        if self.label then
            self.label.Text = self.text .. ": " .. tostring(v)
        end
        self._value = v
        pcall(function() self.onChange(v) end)
    end
    function slider:OnChange(fn)
        if type(fn) == "function" then
            self.onChange = fn
        end
    end

    return slider
end

-- NewToggle: text, tip, callback -> returns Extra object with Toggle control & Extra:NewSlider
