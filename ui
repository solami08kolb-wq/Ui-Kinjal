        hasExtra = true
        Arrow.Visible = true
        Label.Parent.Position = UDim2.new(0, 28, 0, 0)
        Label.Parent.Size = UDim2.new(1, -58, 0, 34)
    end

    Arrow.MouseButton1Click:Connect(function()
        if not hasExtra then return end
        expanded = not expanded
        Arrow.Text = expanded and "v" or ">"
        refreshHeight()
