                    L.Text = subText .. ": " .. tostring(v)
                    extraSlider._value = v
                    pcall(function() subCallback(v) end)
                end
            end
        end)

        function extraSlider:GetValue()
            return self._value
        end
        function extraSlider:SetValue(v)
            v = clamp(math.floor(v or self._value), self.min, self.max)
            local rel = initialFillFor(v, self.min, self.max)
            if self.fill then
                self.fill.Size = UDim2.new(rel, 0, 1, 0)
            end
            if self.label then
                self.label.Text = self.text .. ": " .. tostring(v)
            end
            self._value = v
            pcall(function() self.onChange(v) end)
        end
        function extraSlider:OnChange(fn)
            if type(fn) == "function" then self.onChange = fn end
        end

        refreshHeight()
        return extraSlider
    end

    -- Expose toggle state methods
    local toggleObj = {
        Frame = ToggleFrame,
        IsOn = function() return state end,
        Set = function(val)
            state = not not val
            TweenService:Create(Switch, TweenInfo.new(0.15), {
                BackgroundColor3 = state and Color3.fromRGB(255,255,255) or Color3.fromRGB(35,35,35)
            }):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), {
                Position = state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7),
                BackgroundColor3 = state and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
            }):Play()
            pcall(function() callback(state) end)
        end,
        OnChange = function(fn) if type(fn) == "function" then callback = fn end end
    }

    return toggleObj
end

return Scrp
