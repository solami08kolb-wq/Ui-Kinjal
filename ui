        Position = UDim2.new(0, 10, 0, 32),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = message,
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = NotificationFrame
    })
    
    -- Slide in
    NotificationFrame.Position = UDim2.new(1, 10, 0, 20)
    TweenObject(NotificationFrame, {Position = UDim2.new(1, -290, 0, 20)}, 0.3, Enum.EasingStyle.Quart)
    
    -- Auto remove
    delay(duration, function()
        TweenObject(NotificationFrame, {Position = UDim2.new(1, 10, 0, 20)}, 0.3, Enum.EasingStyle.Quart)
        wait(0.3)
        NotificationFrame:Destroy()
    end)
end

