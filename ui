        AutomaticSize = Enum.AutomaticSize.Y
    })
    create("UIListLayout", {
        Parent = ExtraHolder,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6)
    })
    create("UIPadding", {Parent = ExtraHolder, PaddingBottom = UDim.new(0, 8)})

    local function refreshHeight()
        local extraH = expanded and (ExtraHolder.AbsoluteSize.Y + 34) or 34
        tweenService:Create(ButtonFrame, TweenInfo.new(0.15), {Size = UDim2.new(1,0,0,extraH)}):Play()
    end

    local function EnableArrow()
