
local Scrp = {}
local input = game:GetService("UserInputService")
local runService = game:GetService("RunService")

local CurrentMain = nil
local TitleLabel = nil

local function create(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    return o
end

-- Исправленный драг: без рывков при резком движении мыши
local function DraggingEnabled(frame, parent)
    parent = parent or frame
    local dragging = false
    local mousePos, startPos
    local heartbeatConn

    frame.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = io.Position
            startPos = parent.Position

            if heartbeatConn then heartbeatConn:Disconnect() end
            heartbeatConn = runService.Heartbeat:Connect(function()
                if dragging then
                    local mouseLoc = input:GetMouseLocation()
                    local delta = Vector2.new(mouseLoc.X, mouseLoc.Y) - mousePos
                    parent.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            end)

            io.Changed:Connect(function()
                if io.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if heartbeatConn then
                        heartbeatConn:Disconnect()
                        heartbeatConn = nil
                    end
                end
            end)
        end
    end)

    input.InputEnded:Connect(function(io)
        if (io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch) and dragging then
            dragging = false
            if heartbeatConn then
                heartbeatConn:Disconnect()
                heartbeatConn = nil
            end
        end
    end)
end

function Scrp.CreateWindowLib()
    local LibId = "Scrp_" .. tostring(math.random(1,999999))
    for _,v in pairs(game.CoreGui:GetChildren()) do
        if v.Name == LibId then v:Destroy() end
    end

    local ScreenGui = create("ScreenGui", {
        Name = LibId, Parent = game.CoreGui,
        ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })

    local Main = create("Frame", {
        Name = "Main", Parent = ScreenGui,
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        Position = UDim2.new(0.5, -300, 0.5, -140),
        Size = UDim2.new(0, 600, 0, 280)
    })
    create("UICorner", {CornerRadius = UDim.new(0,6), Parent = Main})

    DraggingEnabled(Main, Main)

    -- Открытие/закрытие на клавишу P
    input.InputBegan:Connect(function(io, gpe)
        if not gpe and io.KeyCode == Enum.KeyCode.P then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)

    CurrentMain = Main -- запоминаем окно для Scrp.Name()

    return ScreenGui, Main
end

-- Задаёт название окна, сверху слева
function Scrp.Name(name)
    name = name or "Window"
    if not CurrentMain then
        warn("Scrp.Name: сначала вызови Scrp.CreateWindowLib()")
        return
    end

    if not TitleLabel then
        TitleLabel = create("TextLabel", {
            Name = "Title",
            Parent = CurrentMain,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 6),
            Size = UDim2.new(1, -20, 0, 20),
            Font = Enum.Font.GothamBold,
            TextSize = 15,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = name
        })
    else
        TitleLabel.Text = name
    end

    return TitleLabel
end

return Scrp
