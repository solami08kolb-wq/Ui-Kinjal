local COLOR_INACTIVE = Color3.fromRGB(18, 18, 18)
local COLOR_ACTIVE   = Color3.fromRGB(45, 45, 45)
local WINDOW_SIZE = UDim2.new(0, 600, 0, 280)

-- Active drag state (single global handler)
local activeDrag = nil -- { kind = "window"|"slider", data = {...} }

-- Utility clamp (roblox has math.clamp, but keep fallback)
local clamp = math.clamp or function(x, a, b) if x < a then return a elseif x > b then return b else return x end end

-- Helper to create Instances
local function create(class, props)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do o[k] = v end
    end
    return o
end

-- Disconnect helpers
local function disconnectAll(list)
    for i = 1, #list do
        local c = list[i]
        if c and typeof(c) == "RBXScriptConnection" then
            pcall(function() c:Disconnect() end)
        end
        list[i] = nil
    end
end

-- Dragging helper sets activeDrag (no per-frame subscriptions)
local function enableWindowDragging(frame, parent)
    parent = parent or frame
    frame.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            -- Capture start state
            activeDrag = {
                kind = "window",
                data = {
                    parent = parent,
                    startPos = parent.Position,
                    startMouse = io.Position,
                    input = io
                }
            }
            -- End when the input ends (per-input)
            io.Changed:Connect(function()
                if io.UserInputState == Enum.UserInputState.End then
                    if activeDrag and activeDrag.kind == "window" and activeDrag.data.input == io then
                        activeDrag = nil
                    end
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch then
            -- No-op: actual movement handled globally in UserInputService.InputChanged
        end
    end)
end

-- Single global input handlers (created on window creation)
local function installGlobalInputHandlers(screenGui, connStore)
    -- InputChanged handles both window dragging and slider dragging
    table.insert(connStore, UserInputService.InputChanged:Connect(function(io)
        if not activeDrag then return end
        local kind = activeDrag.kind
        if kind == "window" then
            local d = activeDrag.data
            if d.input ~= io then return end
            -- compute delta — io.Position should be available
            local delta = io.Position - d.startMouse
            local newX = d.startPos.X.Offset + delta.X
            local newY = d.startPos.Y.Offset + delta.Y
            d.parent.Position = UDim2.new(d.startPos.X.Scale, newX, d.startPos.Y.Scale, newY)
        elseif kind == "slider" then
            local d = activeDrag.data
            if d and d.bar and d.bar.AbsoluteSize.X > 0 then
                local absPos = d.bar.AbsolutePosition
                local absSize = d.bar.AbsoluteSize
                local rel = clamp((io.Position.X - absPos.X) / absSize.X, 0, 1)
                local span = d.max - d.min
                if span == 0 then span = 1 end
                local value = math.floor(d.min + span * rel)
                -- update visuals
                if d.fill then
                    d.fill.Size = UDim2.new(rel, 0, 1, 0)
                end
                if d.label then
                    d.label.Text = d.text .. ": " .. tostring(value)
                end
                if d.onChange then
                    -- protect callback
                    pcall(function() d.onChange(value) end)
                end
                d._value = value
            end
        end
    end))

    -- InputEnded clears activeDrag when mouse button released
    table.insert(connStore, UserInputService.InputEnded:Connect(function(io)
        if not activeDrag then return end
        if activeDrag.kind == "slider" then
            -- if left click ended, stop dragging
            if io.UserInputType == Enum.UserInputType.MouseButton1 then
                activeDrag = nil
            end
        elseif activeDrag.kind == "window" then
            if io.UserInputState == Enum.UserInputState.End then
                activeDrag = nil
            end
        end
    end))
end

-- Safe function to compute initial fill ratio
local function initialFillFor(default, min, max)
    local span = (max - min)
    if span == 0 then span = 1 end
    return clamp((default - min) / span, 0, 1)
end

-- Show info tip (panel slide)
local infoShowToken = 0
local function ShowInfo(text)
    if not InfoPanel then return end
    infoShowToken = infoShowToken + 1
    local myToken = infoShowToken

    local InfoText = InfoPanel:FindFirstChild("InfoText")
    if InfoText then
        InfoText.Text = text or ""
    end
    InfoPanel.Position = UDim2.new(0, 130, 1, 0)
    TweenService:Create(InfoPanel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 130, 1, -40)
    }):Play()

    task.delay(2, function()
        if myToken ~= infoShowToken then return end
        TweenService:Create(InfoPanel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 130, 1, 0)
        }):Play()
    end)
end

-- Info dot helper
local function AddInfoDot(parentFrame, tipText)
    tipText = tipText or ""
    local Dot = create("TextButton", {
        Name = "InfoDot",
        Parent = parentFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -20, 0.5, -8),
