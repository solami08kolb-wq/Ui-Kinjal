local function create(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    return o
end

-- ===== Драг окна =====
local function DraggingEnabled(frame, parent)
    parent = parent or frame
    local dragging = false
    local dragInput, mousePos, startPos

    frame.InputBegan:Connect(function(io)
        if WindowDragBlocked then return end
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = io.Position
            startPos = parent.Position

            io.Changed:Connect(function()
                if io.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch then
            dragInput = io
        end
    end)

    input.InputChanged:Connect(function(io)
        if io == dragInput and dragging and not WindowDragBlocked then
            local delta = io.Position - mousePos
            parent.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        elseif WindowDragBlocked then
            dragging = false
        end
    end)
end

-- ===== Создание окна =====
function Scrp.CreateWindowLib()
    local LibId = "Scrp_" .. tostring(math.random(1,999999))
    for _,v in pairs(game.CoreGui:GetChildren()) do
        if v.Name == LibId then v:Destroy() end
    end

    local ScreenGui = create("ScreenGui", {
        Name = LibId, Parent = game.CoreGui,
        ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })

    -- AnchorPoint по центру — теперь Size-анимация не двигает окно, схлопывается на месте
    local Main = create("Frame", {
        Name = "Main", Parent = ScreenGui,
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        ClipsDescendants = true,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = WINDOW_SIZE
    })
    create("UICorner", {CornerRadius = UDim.new(0,6), Parent = Main})

    DraggingEnabled(Main, Main)

    -- Анимация открытия/закрытия на P (масштаб к своему же центру, без сдвига)
    local isOpen = true
    local animating = false

    input.InputBegan:Connect(function(io, gpe)
        if not gpe and io.KeyCode == Enum.KeyCode.P and not animating then
            animating = true
            WindowDragBlocked = true -- блокируем драг на время анимации, чтобы не конфликтовало

            if isOpen then
                local tw = tweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 0)
                })
                tw:Play()
                tw.Completed:Connect(function()
                    Main.Visible = false
                    isOpen = false
                    animating = false
                    WindowDragBlocked = false
                end)
            else
                Main.Visible = true
                Main.Size = UDim2.new(0, 0, 0, 0)

                local tw = tweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = WINDOW_SIZE
                })
                tw:Play()
                tw.Completed:Connect(function()
                    isOpen = true
                    animating = false
                    WindowDragBlocked = false
                end)
            end
        end
    end)

    CurrentMain = Main

    TabHolder = create("Frame", {
        Name = "TabHolder", Parent = Main,
        BackgroundColor3 = Color3.fromRGB(15, 15, 15),
        Position = UDim2.new(0, 0, 0, 30),
        Size = UDim2.new(0, 130, 1, -30)
    })
    create("UIListLayout", {
        Parent = TabHolder,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2)
    })
    create("UIPadding", {
        Parent = TabHolder,
        PaddingTop = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6)
    })

    ContentHolder = create("Frame", {
        Name = "ContentHolder", Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 130, 0, 30),
        Size = UDim2.new(1, -130, 1, -30)
    })

    InfoPanel = create("Frame", {
        Name = "InfoPanel", Parent = Main,
        BackgroundColor3 = Color3.fromRGB(25, 25, 25),
        Position = UDim2.new(0, 130, 1, 0),
        Size = UDim2.new(1, -130, 0, 36),
        ZIndex = 50
    })
    create("UICorner", {CornerRadius = UDim.new(0,4), Parent = InfoPanel})
    local InfoText = create("TextLabel", {
        Name = "InfoText", Parent = InfoPanel,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        Font = Enum.Font.Gotham, TextSize = 13,
        TextColor3 = Color3.fromRGB(255,255,255),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Text = ""
    })

    return ScreenGui, Main
end

-- Показывает всплывающую подсказку снизу на 2 секунды
local infoShowToken = 0
local function ShowInfo(text)
    if not InfoPanel then return end
    infoShowToken = infoShowToken + 1
    local myToken = infoShowToken

    InfoPanel.InfoText.Text = text
    InfoPanel.Position = UDim2.new(0, 130, 1, 0)
    tweenService:Create(InfoPanel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 130, 1, -40)
    }):Play()

    task.delay(2, function()
        if myToken ~= infoShowToken then return end
        tweenService:Create(InfoPanel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 130, 1, 0)
        }):Play()
    end)
end

-- Создаёт инфо-точку в конце элемента
local function AddInfoDot(parentFrame, tipText)
    tipText = tipText or ""
    local Dot = create("TextButton", {
        Name = "InfoDot",
        Parent = parentFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -20, 0.5, -8),
        Size = UDim2.new(0, 16, 0, 16),
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        Text = "•",
        TextColor3 = Color3.fromRGB(150, 150, 150)
    })
    Dot.MouseButton1Click:Connect(function()
        ShowInfo(tipText)
    end)
    return Dot
end

-- Название окна — размер шрифта НЕ трогаем (осталось 15)
function Scrp.Name(name)
    name = name or "Window"
    if not CurrentMain then
        warn("Scrp.Name: сначала вызови Scrp.CreateWindowLib()")
        return
    end

    if not TitleLabel then
        TitleLabel = create("TextLabel", {
            Name = "Title",
            Parent = CurrentMain,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 6),
            Size = UDim2.new(1, -20, 0, 20),
            Font = Enum.Font.GothamBold,
            TextSize = 15,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = name
        })
    else
        TitleLabel.Text = name
    end

    return TitleLabel
end

function Scrp.LeftNewTab(name)
    name = name or "Tab"
    if not TabHolder or not ContentHolder then
        warn("Scrp.LeftNewTab: сначала вызови Scrp.CreateWindowLib()")
        return
    end

    local TabBtn = create("TextButton", {
        Name = name .. "Btn",
        Parent = TabHolder,
        BackgroundColor3 = COLOR_INACTIVE,
        Size = UDim2.new(1, 0, 0, 30),
        AutoButtonColor = false,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        Text = name,
        TextColor3 = Color3.fromRGB(255, 255, 255)
    })
    create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = TabBtn})

    local Page = create("ScrollingFrame", {
        Name = name .. "Page",
        Parent = ContentHolder,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 3,
        Visible = false,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0)
    })
    create("UIListLayout", {
        Parent = Page,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8)
    })
    create("UIPadding", {
        Parent = Page,
        PaddingLeft = UDim.new(0, 10),
        PaddingTop = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10)
    })

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Page.Visible = false
            t.Btn.BackgroundColor3 = COLOR_INACTIVE
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = COLOR_ACTIVE
    end)

    if firstTab then
        firstTab = false
        Page.Visible = true
        TabBtn.BackgroundColor3 = COLOR_ACTIVE
    end

    table.insert(Tabs, {Btn = TabBtn, Page = Page, Name = name})
    CurrentPage = Page

    return Page
end

-- ===== СЛАЙДЕР (полоса укорочена, чтобы точка инфо помещалась справа) =====
function Scrp.NewSlider(text, tip, max, min, callback)
    text = text or "Slider"
    tip = tip or ""
    max = max or 100
    min = min or 0
    callback = callback or function() end

    if not CurrentPage then
        warn("Scrp.NewSlider: сначала вызови Scrp.LeftNewTab(\"name\")")
        return
    end

    local default = min

    local SliderFrame = create("Frame", {
        Parent = CurrentPage,
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        Size = UDim2.new(1, 0, 0, 40)
    })
    create("UICorner", {CornerRadius = UDim.new(0,4), Parent = SliderFrame})

    local Label = create("TextLabel", {
        Parent = SliderFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 4),
        Size = UDim2.new(1, -30, 0, 16),
        Font = Enum.Font.Gotham,
        TextSize = 14, -- увеличено с 12
        Text = text .. ": " .. tostring(default),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextXAlignment = Enum.TextXAlignment.Left
    })

    -- Полоса короче: было -20, стало -34, освобождает место под точку инфо
    local Bar = create("Frame", {
        Parent = SliderFrame,
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        Position = UDim2.new(0, 10, 0, 26),
        Size = UDim2.new(1, -34, 0, 6)
    })
    create("UICorner", {CornerRadius = UDim.new(1,0), Parent = Bar})

    local Fill = create("Frame", {
        Parent = Bar,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    })
    create("UICorner", {CornerRadius = UDim.new(1,0), Parent = Fill})

    AddInfoDot(SliderFrame, tip)

    local dragging = false
    local function update(io)
        local rel = math.clamp((io.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * rel)
        Fill.Size = UDim2.new(rel, 0, 1, 0)
        Label.Text = text .. ": " .. tostring(value)
        callback(value)
    end

    Bar.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            WindowDragBlocked = true
            update(io)
        end
    end)
    input.InputChanged:Connect(function(io)
        if dragging and io.UserInputType == Enum.UserInputType.MouseMovement then
            update(io)
        end
    end)
    input.InputEnded:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 then
            if dragging then
                dragging = false
                WindowDragBlocked = false
            end
        end
    end)

    return SliderFrame
end

