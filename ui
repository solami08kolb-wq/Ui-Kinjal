    local startPos = nil
    
    local TitleBar = CreateInstance("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = CurrentTheme.Second,
        BorderSizePixel = 0,
        Parent = MainFrame,
        ZIndex = 6
