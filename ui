    })
    create("UIPadding", {Parent = ExtraHolder, PaddingBottom = UDim.new(0, 8)})

    local function refreshHeight()
        local extraH = expanded and (ExtraHolder.AbsoluteSize.Y + 34) or 34
        tweenService:Create(ToggleFrame, TweenInfo.new(0.15), {Size = UDim2.new(1,0,0,extraH)}):Play()
    end

    local function EnableArrow()
        if hasExtra then return end
        hasExtra = true
        Arrow.Visible = true
        Label.Position = UDim2.new(0, 28, 0, 0)
        Label.Size = UDim2.new(1, -95, 0, 34)
    end

    Switch.MouseButton1Click:Connect(function()
        state = not state
        tweenService:Create(Switch, TweenInfo.new(0.15), {
            BackgroundColor3 = state and Color3.fromRGB(255,255,255) or Color3.fromRGB(35,35,35)
        }):Play()
        tweenService:Create(Knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7),
            BackgroundColor3 = state and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
        }):Play()
        callback(state)
    end)

    Arrow.MouseButton1Click:Connect(function()
        if not hasExtra then return end
        expanded = not expanded
        Arrow.Text = expanded and "v" or ">"
        refreshHeight()
    end)

    local Extra = {}

    -- Вложенная кнопка внутри тоггла
    function Extra:NewButton(subText, subTip, subCallback)
        subText = subText or "Button"
        subTip = subTip or ""
        subCallback = subCallback or function() end

        EnableArrow()

        local BF = create("Frame", {
            Parent = ExtraHolder,
            BackgroundColor3 = Color3.fromRGB(28, 28, 28),
            Size = UDim2.new(1, 0, 0, 30)
        })
        create("UICorner", {CornerRadius = UDim.new(0,4), Parent = BF})

        local Click = create("TextButton", {
            Parent = BF,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 0),
            Size = UDim2.new(1, -34, 1, 0),
            AutoButtonColor = false,
            Text = ""
        })

        local Label = create("TextLabel", {
            Parent = Click,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            Text = subText,
            TextColor3 = Color3.fromRGB(255,255,255),
            TextXAlignment = Enum.TextXAlignment.Left
        })

        AddInfoDot(BF, subTip)

        Click.MouseEnter:Connect(function()
            tweenService:Create(BF, TweenInfo.new(0.12), {
                BackgroundColor3 = Color3.fromRGB(38, 38, 38)
            }):Play()
        end)

        Click.MouseLeave:Connect(function()
            tweenService:Create(BF, TweenInfo.new(0.12), {
                BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            }):Play()
        end)

        Click.MouseButton1Click:Connect(function()
            tweenService:Create(BF, TweenInfo.new(0.08), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            }):Play()

            task.delay(0.08, function()
                if BF.Parent then
                    tweenService:Create(BF, TweenInfo.new(0.12), {
                        BackgroundColor3 = Color3.fromRGB(28, 28, 28)
                    }):Play()
                end
            end)

            subCallback()
        end)

        refreshHeight()
        return BF
    end

    function Extra:NewSlider(subText, subTip, max, min, subCallback)
        subText = subText or "Slider"
        subTip = subTip or ""
        max = max or 100
        min = min or 0
        subCallback = subCallback or function() end
        local sdefault = min

        EnableArrow()

        local SF = create("Frame", {
            Parent = ExtraHolder,
            BackgroundColor3 = Color3.fromRGB(28, 28, 28),
            Size = UDim2.new(1, 0, 0, 36)
        })
        create("UICorner", {CornerRadius = UDim.new(0,4), Parent = SF})

        local L = create("TextLabel", {
            Parent = SF,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 2),
            Size = UDim2.new(1, -34, 0, 14),
            Font = Enum.Font.Gotham, TextSize = 12, -- увеличено с 11
            Text = subText .. ": " .. tostring(sdefault),
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextXAlignment = Enum.TextXAlignment.Left
        })

        -- Полоса короче для точки инфо
        local Bar = create("Frame", {
            Parent = SF,
            BackgroundColor3 = Color3.fromRGB(45, 45, 45),
            Position = UDim2.new(0, 8, 0, 22),
            Size = UDim2.new(1, -34, 0, 5)
        })
        create("UICorner", {CornerRadius = UDim.new(1,0), Parent = Bar})

        local Fill = create("Frame", {
            Parent = Bar,
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Size = UDim2.new((sdefault - min) / (max - min), 0, 1, 0)
        })
        create("UICorner", {CornerRadius = UDim.new(1,0), Parent = Fill})

        AddInfoDot(SF, subTip)

        local dragging2 = false
        local function update(io)
            local rel = math.clamp((io.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
            local v = math.floor(min + (max - min) * rel)
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            L.Text = subText .. ": " .. tostring(v)
            subCallback(v)
        end

        Bar.InputBegan:Connect(function(io)
            if io.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging2 = true
                WindowDragBlocked = true
                update(io)
            end
        end)
        input.InputChanged:Connect(function(io)
            if dragging2 and io.UserInputType == Enum.UserInputType.MouseMovement then
                update(io)
            end
        end)
        input.InputEnded:Connect(function(io)
            if io.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging2 then
                    dragging2 = false
                    WindowDragBlocked = false
                end
            end
        end)

        refreshHeight()
        return SF
    end

    return Extra
end

return Scrp
