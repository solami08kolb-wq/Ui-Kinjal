    ClickArea.MouseEnter:Connect(function()
        tweenService:Create(ButtonFrame, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(28, 28, 28)}):Play()
    end)
    ClickArea.MouseLeave:Connect(function()
        tweenService:Create(ButtonFrame, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}):Play()
    end)

    ClickArea.MouseButton1Click:Connect(function()
        tweenService:Create(ButtonFrame, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(45, 45, 45)}):Play()
        task.delay(0.08, function()
            tweenService:Create(ButtonFrame, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}):Play()
        end)
        callback()
    end)

    local Extra = {}

    -- Вложенный слайдер внутри кнопки
    function Extra:NewSlider(subText, subTip, max, min, subCallback)
