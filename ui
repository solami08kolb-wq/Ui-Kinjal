local Library = {}

-- Безопасное получение сервисов
local function GetService(serviceName)
    local success, service = pcall(function()
        return game:GetService(serviceName)
    end)
    if success then
        return service
    else
        return nil
    end
end

-- Безопасное получение Players
local function GetPlayers()
    local success, players = pcall(function()
        return game:GetService("Players")
    end)
    if success then
        return players
    else
        return nil
    end
end

-- Безопасное получение LocalPlayer
local function GetLocalPlayer()
    local players = GetPlayers()
    if players then
        local success, player = pcall(function()
            return players.LocalPlayer
        end)
        if success then
            return player
        end
    end
    return nil
end

-- Безопасное получение Mouse
local function GetMouse()
    local player = GetLocalPlayer()
    if player then
        local success, mouse = pcall(function()
            return player:GetMouse()
        end)
        if success then
            return mouse
        end
    end
    return nil
end

-- Сервисы с проверкой
local TweenService = GetService("TweenService")
local UserInputService = GetService("UserInputService")
local RunService = GetService("RunService")

-- Утилиты
local Utility = {}

function Utility:Tween(obj, properties, duration, easingStyle, easingDirection)
    if not TweenService then return end
    local tweenInfo = TweenInfo.new(
        duration or 0.5,
        easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(obj, tweenInfo, properties)
    tween:Play()
    return tween
end

-- Фиксированные цвета
