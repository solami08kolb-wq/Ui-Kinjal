                    Slider.Value = math.round(value)
                    Flags[sliderName] = Slider.Value
                    
                    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
                    SliderButton.Position = UDim2.new(percentage, -9, 0.5, -9)
                    ValueLabel.Text = tostring(Slider.Value)
                    
                    if callback then
                        callback(Slider.Value)
                    end
                end
                
                -- Drag functionality
                local dragging = false
                
                SliderButton.MouseButton1Down:Connect(function()
                    dragging = true
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateSlider(input)
                    end
                end)
                
                SliderBackground.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        UpdateSlider(input)
                    end
                end)
                
                Slider.Instance = SliderFrame
                Slider.Set = function(value)
                    value = math.clamp(value, Slider.Min, Slider.Max)
                    Slider.Value = value
                    local percentage = (value - Slider.Min) / (Slider.Max - Slider.Min)
                    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
                    SliderButton.Position = UDim2.new(percentage, -9, 0.5, -9)
                    ValueLabel.Text = tostring(value)
                    Flags[sliderName] = value
                    
                    if callback then
                        callback(value)
                    end
                end
                
                table.insert(Section.Elements, Slider)
                table.insert(Elements, Slider)
                
                return Slider
            end
            
            -- // Dropdown Element
            function Section:AddDropdown(dropdownName, options, default, callback)
                local Dropdown = {}
                Dropdown.Type = "Dropdown"
                Dropdown.Name = dropdownName
                Dropdown.Options = options or {}
                Dropdown.Value = default or options[1] or ""
                Dropdown.Open = false
                Flags[dropdownName] = Dropdown.Value
                
                local DropdownFrame = CreateInstance("Frame", {
                    Name = dropdownName,
                    Size = UDim2.new(1, 0, 0, 45),
                    BackgroundColor3 = Theme.Third,
                    BorderSizePixel = 0,
                    Parent = SectionContent,
                    ClipsDescendants = false
                })
                
                AddCorner(DropdownFrame, 6)
                
                -- Dropdown Label
                local DropdownLabel = CreateInstance("TextLabel", {
                    Name = "Label",
                    Size = UDim2.new(0.5, 0, 1, 0),
                    Position = UDim2.new(0, 15, 0, 0),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamMedium,
                    Text = dropdownName,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = DropdownFrame
                })
                
                -- Dropdown Button
                local DropdownButton = CreateInstance("TextButton", {
                    Name = "DropdownBtn",
                    Size = UDim2.new(0.5, -15, 0, 35),
                    Position = UDim2.new(0.5, 0, 0, 5),
                    BackgroundColor3 = Theme.Second,
                    BorderSizePixel = 0,
                    Font = Enum.Font.GothamMedium,
                    Text = Dropdown.Value,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    AutoButtonColor = false,
                    Parent = DropdownFrame
                })
                
                AddCorner(DropdownButton, 5)
                
                -- Dropdown Options Container
                local OptionsContainer = CreateInstance("ScrollingFrame", {
                    Name = "Options",
                    Size = UDim2.new(0.5, -15, 0, 0),
                    Position = UDim2.new(0.5, 0, 0, 42),
                    BackgroundColor3 = Theme.Second,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Theme.Accent,
                    Parent = DropdownFrame,
                    Visible = false,
                    ZIndex = 50,
                    CanvasSize = UDim2.new(0, 0, 0, #options * 35)
                })
                
                AddCorner(OptionsContainer, 5)
                AddStroke(OptionsContainer, Theme.Accent, 1)
                
                -- Options List
                local OptionsList = CreateInstance("UIListLayout", {
                    Name = "OptionsList",
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = OptionsContainer
                })
                
                -- Create option buttons
                for i, option in pairs(options) do
                    local OptionButton = CreateInstance("TextButton", {
                        Name = option,
                        Size = UDim2.new(1, 0, 0, 35),
                        BackgroundColor3 = Theme.Second,
                        BorderSizePixel = 0,
                        Font = Enum.Font.Gotham,
                        Text = option,
                        TextColor3 = Theme.Text,
                        TextSize = 12,
                        AutoButtonColor = false,
                        Parent = OptionsContainer,
                        ZIndex = 51
                    })
                    
                    OptionButton.MouseEnter:Connect(function()
                        TweenObject(OptionButton, {BackgroundColor3 = Theme.AccentDark}, 0.1)
                    end)
                    
                    OptionButton.MouseLeave:Connect(function()
                        TweenObject(OptionButton, {BackgroundColor3 = Theme.Second}, 0.1)
                    end)
                    
                    OptionButton.MouseButton1Click:Connect(function()
                        Dropdown.Value = option
                        DropdownButton.Text = option
                        Flags[dropdownName] = option
                        Dropdown.Open = false
                        OptionsContainer.Visible = false
                        TweenObject(OptionsContainer, {Size = UDim2.new(0.5, -15, 0, 0)}, 0.2)
                        
                        if callback then
                            callback(option)
                        end
                    end)
                end
                
                -- Toggle dropdown
                DropdownButton.MouseButton1Click:Connect(function()
                    Dropdown.Open = not Dropdown.Open
                    OptionsContainer.Visible = Dropdown.Open
                    
                    if Dropdown.Open then
                        TweenObject(OptionsContainer, {Size = UDim2.new(0.5, -15, 0, math.min(#options * 35, 140))}, 0.2)
                    else
                        TweenObject(OptionsContainer, {Size = UDim2.new(0.5, -15, 0, 0)}, 0.2)
                    end
                end)
                
                Dropdown.Instance = DropdownFrame
                Dropdown.Set = function(value)
                    Dropdown.Value = value
                    DropdownButton.Text = value
                    Flags[dropdownName] = value
                    
                    if callback then
                        callback(value)
                    end
                end
                
                table.insert(Section.Elements, Dropdown)
                table.insert(Elements, Dropdown)
                
                return Dropdown
            end
            
            return Section
        end
        
        return Tab
    end
    
    -- // Notification
    function Window:Notify(title, message, duration)
        Notify(title, message, duration)
    end
    
    -- // Get Flags
    function Window:GetFlags()
        return Flags
    end
    
    return Window
end

-- // Return Library
return VisualLibrary
