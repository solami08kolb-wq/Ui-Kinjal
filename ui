    local state = false
    local expanded = false
    local hasExtra = false

    local ToggleFrame = create("Frame", {
        Parent = CurrentPage,
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        Size = UDim2.new(1, 0, 0, 34),
        ClipsDescendants = true
